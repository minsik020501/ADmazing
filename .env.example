# ---- 번역 (OpenAI) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# ---- 이미지 생성 ----
# mock: 모델 없이 더미 이미지 반환 (개발용, torch 불필요)
# diffusers: 실제 모델로 생성 (INSTALL_ML=true 로 빌드해야 함)
IMAGE_GENERATOR=mock
INSTALL_ML=false

# Hugging Face 모델 이름 또는 산출물 경로 (예: /models/ad-v1)
MODEL_PATH=stabilityai/sdxl-turbo
# LoRA 산출물 경로 (선택, 예: /models/ad-lora-v1)
LORA_PATH=
NUM_INFERENCE_STEPS=4
GUIDANCE_SCALE=0.0
# 요청에 width/height가 없을 때 사용하는 기본 이미지 크기
DEFAULT_IMAGE_WIDTH=512
DEFAULT_IMAGE_HEIGHT=512
# gated 모델을 쓸 경우에만 필요
HF_TOKEN=
