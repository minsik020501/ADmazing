# ---- 번역 (OpenAI) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# ---- 이미지 생성 ----
# mock: 모델 없이 더미 이미지 반환 (개발용, torch 불필요)
# diffusers: MODEL_PATH의 모델로 생성 (INSTALL_ML=true 로 빌드해야 함)
# sdxl: SDXL 기본 모델 + fp16 VAE로 생성 (INSTALL_ML=true, 아래 SDXL_* 설정 사용)
# zimage: Z-Image-Turbo로 생성 (INSTALL_ML=true, 아래 ZIMAGE_* 설정 사용)
IMAGE_GENERATOR=mock
INSTALL_ML=false

# Hugging Face 모델 이름 또는 산출물 경로 (예: /models/ad-v1)
MODEL_PATH=stabilityai/sdxl-turbo
# LoRA 산출물 경로 (선택, 예: /models/ad-lora-v1)
LORA_PATH=
NUM_INFERENCE_STEPS=4
GUIDANCE_SCALE=0.0
# gated 모델을 쓸 경우에만 필요
HF_TOKEN=
# 한 번의 요청에서 생성할 이미지 장수 (1 이상, 배치로 한 번에 생성하므로 VRAM 사용량이 늘어남)
NUM_IMAGES_PER_REQUEST=4
# 생성 요청마다 측정 로그(JSONL: 일시, 장수, 소요 시간, VRAM 최대 사용량 등)를 남길 경로
# api 컨테이너 기준 경로. docker-compose.yml이 레포 루트 logs/를 /app/logs로 마운트함
# 비워 두면 기록하지 않음
GENERATION_LOG_PATH=/app/logs/generation.jsonl

# ---- SDXL (IMAGE_GENERATOR=sdxl, backend/ai/sdxl_pipeline.py 공용) ----
# 값을 비워 두면 코드의 기본값을 사용
# 실행 디바이스: auto(cuda → mps → cpu 순), cuda, mps, cpu
SDXL_DEVICE=auto
# cuda 전용. 1: 오프로드(GPU 계산 + CPU 램 보관, 8GB GPU용), 0: GPU 전용
SDXL_USE_OFFLOAD=1
SDXL_STEPS=25
SDXL_GUIDANCE_SCALE=6.0
# 이미지 크기 (8의 배수). backend/ai 실험 스크립트 전용
# api 서버는 요청의 ratio에 맞는 해상도(app/core/image_ratio.py)를 사용하므로 적용되지 않음
SDXL_WIDTH=1024
SDXL_HEIGHT=1024
# 비워 두면 "blurry, low quality, text, watermark, deformed"
SDXL_NEGATIVE_PROMPT=
# 모델 폴더 (상대 경로는 레포 루트 기준, 실험 스크립트용)
# api 컨테이너에서는 docker-compose.yml이 /models/... 로 덮어씀
SDXL_MODEL_DIR=models/sdxl-base
SDXL_VAE_DIR=models/sdxl-vae-fp16-fix

# ---- Z-Image-Turbo (IMAGE_GENERATOR=zimage) ----
# 값을 비워 두면 코드의 기본값을 사용
# 실행 디바이스: auto(cuda → mps → cpu 순), cuda, mps, cpu
ZIMAGE_DEVICE=auto
# cuda 전용. 1: 오프로드(GPU 계산 + CPU 램 보관), 0: GPU 전용 (bf16 가중치만 약 20GB라 그 이상의 VRAM 필요)
ZIMAGE_USE_OFFLOAD=1
# 모델 카드 권장값 9. guidance scale은 Turbo 모델이라 0으로 고정
ZIMAGE_STEPS=9
# 모델 폴더 (api 컨테이너에서는 docker-compose.yml이 /models/z-image-turbo로 덮어씀)
ZIMAGE_MODEL_DIR=models/z-image-turbo
