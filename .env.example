# ---- 번역·문구 추천 (OpenAI) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# ---- 문구 추천 (생성된 이미지마다 title/subtitle/text 문구를 역할별 5개씩 + 강조색) ----
# 요청의 keywords(필수 단어·문장, 최대 3개)가 있으면 모든 문구에 글자 그대로 넣는다
# openai: 이미지와 프롬프트를 OpenAI에 보내 추천, mock: OpenAI 없이 고정 문구 반환 (개발용)
COPY_RECOMMENDER=openai
# 문구 추천에 쓸 모델 (이미지 입력 지원 모델). 비워 두면 OPENAI_MODEL을 사용
COPY_OPENAI_MODEL=
# 추론 모델(gpt-5 계열 이후)의 reasoning_effort: none | low | medium | high. 비워 두면 보내지 않음
# (추론 모델이 아니면 비워야 함). 기본(medium)은 한 번에 11~23초라 시간 제한을 넘기므로 none 권장
COPY_REASONING_EFFORT=none
# 이미지 1장의 문구 추천(재요청 포함) 최대 시간(초). 넘으면 그 이미지만 copies_error로 응답
COPY_TIMEOUT_SECONDS=20
# OpenAI에 보낼 이미지의 긴 변(px). 분위기·색감·피사체만 보면 되므로 줄여서 보낸다
COPY_IMAGE_MAX_SIDE=512

# ---- 문구 배치 추천 (이미지 + 문구 → 위치·글꼴·색 추천안 3~5개) ----
# 광고 레이아웃 템플릿과 규칙으로 만든다 (CPU, LLM 없음). 가리면 안 되는 영역(제품, 얼굴)을
# 전용 검출기로 찾아 피한다. 0이면 영역을 피하지 않는다 (모델 파일이 없는 개발 환경용)
LAYOUT_DETECT_SUBJECTS=1
# 검출기 모델 파일 (api 컨테이너에서는 docker-compose.yml이 /models/detectors/...로 덮어씀)
# 주 피사체 분리 U²-Net (약 170MB):
#   curl -L -o models/detectors/u2net.onnx https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx
# 얼굴 검출 YuNet (약 230KB):
#   curl -L -o models/detectors/face_detection_yunet_2023mar.onnx https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
LAYOUT_SALIENT_MODEL_PATH=models/detectors/u2net.onnx
LAYOUT_FACE_MODEL_PATH=models/detectors/face_detection_yunet_2023mar.onnx

# ---- 이미지 생성 ----
# mock: 모델 없이 더미 이미지 반환 (개발용, torch 불필요)
# diffusers: MODEL_PATH의 모델로 생성 (INSTALL_ML=true 로 빌드해야 함)
# sdxl: SDXL 기본 모델 + fp16 VAE로 생성 (INSTALL_ML=true, 아래 SDXL_* 설정 사용)
# zimage: Z-Image-Turbo로 생성 (INSTALL_ML=true, 아래 ZIMAGE_* 설정 사용)
IMAGE_GENERATOR=mock
INSTALL_ML=false

# ---- Docker GPU (NVIDIA GPU 서버 전용) ----
# 주석을 풀면 docker compose 명령에 GPU 설정(docker-compose.gpu.yml)이 항상 포함된다.
# 빠뜨리면 api 컨테이너가 GPU를 못 보고 CPU로 생성하려다 램 부족으로 종료될 수 있다.
# NVIDIA 드라이버·Container Toolkit이 없는 환경(Mac 등)에서 켜면 컨테이너가 뜨지 않으므로 그대로 둔다
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Hugging Face 모델 이름 또는 산출물 경로 (예: /models/ad-v1)
MODEL_PATH=stabilityai/sdxl-turbo
# LoRA 산출물 경로 (선택, 예: /models/ad-lora-v1)
LORA_PATH=
NUM_INFERENCE_STEPS=4
GUIDANCE_SCALE=0.0
# gated 모델을 쓸 경우에만 필요
HF_TOKEN=
# 한 번의 요청에서 생성할 이미지 장수 (1 이상, 배치로 한 번에 생성하므로 VRAM 사용량이 늘어남)
NUM_IMAGES_PER_REQUEST=4
# 생성 요청마다 측정 로그(JSONL: 일시, 장수, 소요 시간, VRAM 최대 사용량 등)를 남길 경로
# api 컨테이너 기준 경로. docker-compose.yml이 레포 루트 logs/를 /app/logs로 마운트함
# 비워 두면 기록하지 않음
GENERATION_LOG_PATH=/app/logs/generation.jsonl

# ---- SDXL (IMAGE_GENERATOR=sdxl, backend/ai/sdxl_pipeline.py 공용) ----
# 값을 비워 두면 코드의 기본값을 사용
# 실행 디바이스: auto(cuda → mps → cpu 순), cuda, mps, cpu
# GPU 서버에서는 cuda 권장: GPU를 못 잡으면 CPU로 넘어가지 않고 시작할 때 바로 에러로 알린다
SDXL_DEVICE=auto
# cuda 전용. 1: 오프로드(GPU 계산 + CPU 램 보관, 8GB GPU용), 0: GPU 전용
SDXL_USE_OFFLOAD=1
SDXL_STEPS=25
SDXL_GUIDANCE_SCALE=6.0
# 이미지 크기 (8의 배수). backend/ai 실험 스크립트 전용
# api 서버는 요청의 ratio에 맞는 해상도(app/core/image_ratio.py)를 사용하므로 적용되지 않음
SDXL_WIDTH=1024
SDXL_HEIGHT=1024
# 비워 두면 "blurry, low quality, text, watermark, deformed"
SDXL_NEGATIVE_PROMPT=
# 모델 폴더 (상대 경로는 레포 루트 기준, 실험 스크립트용)
# api 컨테이너에서는 docker-compose.yml이 /models/... 로 덮어씀
SDXL_MODEL_DIR=models/sdxl-base
SDXL_VAE_DIR=models/sdxl-vae-fp16-fix

# ---- Z-Image-Turbo (IMAGE_GENERATOR=zimage) ----
# 값을 비워 두면 코드의 기본값을 사용
# 실행 디바이스: auto(cuda → mps → cpu 순), cuda, mps, cpu
# GPU 서버에서는 cuda 권장: GPU를 못 잡으면 CPU로 넘어가지 않고 시작할 때 바로 에러로 알린다
ZIMAGE_DEVICE=auto
# cuda 전용. bf16 가중치가 약 19GB
# 0: GPU 전용 (VRAM 22GB 이상, 예: L4 24GB). 모델을 GPU로 바로 불러와 램이 적어도 됨
# 1: 오프로드 (GPU 계산 + CPU 램 보관). VRAM이 부족할 때 쓰며 램이 24GB 이상 필요
ZIMAGE_USE_OFFLOAD=0
# 모델 카드 권장값 9. guidance scale은 Turbo 모델이라 0으로 고정
ZIMAGE_STEPS=9
# 모델 폴더 (api 컨테이너에서는 docker-compose.yml이 /models/z-image-turbo로 덮어씀)
ZIMAGE_MODEL_DIR=models/z-image-turbo
# 가중치 양자화 (cuda 전용): none(원본 bf16), int8, fp8
# int8, fp8은 transformer·text_encoder 가중치를 8bit로 줄여 VRAM을 아낀다 (연산은 bf16)
# fp8은 SM 8.9 이상 GPU(L4, RTX 40xx, H100 등)에서만 동작한다. 그보다 오래된 GPU는 int8
# docker compose up 시 model-prep이 models/z-image-turbo-<종류>/가 없으면 원본에서 변환해 만든다
# (첫 실행에만 시간이 걸리고, torch·torchao·diffusers·transformers 버전이 바뀌면 다시 변환)
ZIMAGE_QUANT=none
